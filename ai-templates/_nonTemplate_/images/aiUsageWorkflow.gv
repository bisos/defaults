digraph {
	nodesep=0.35 rankdir=TB ranksep=0.45
	node [fontsize=12]
	lyr_start [label="Session start" fontcolor=gray30 fontsize=11 shape=plaintext]
	lyr_loop1 [label="Work loop
(per TODO)" fontcolor=gray30 fontsize=11 shape=plaintext]
	lyr_loop2 [label="" fontcolor=gray30 fontsize=11 shape=plaintext]
	lyr_loop3 [label="" fontcolor=gray30 fontsize=11 shape=plaintext]
	lyr_loop4 [label="" fontcolor=gray30 fontsize=11 shape=plaintext]
	lyr_loop5 [label="" fontcolor=gray30 fontsize=11 shape=plaintext]
	lyr_end [label="Session end" fontcolor=gray30 fontsize=11 shape=plaintext]
	lyr_start -> lyr_loop1 [style=invis]
	lyr_loop1 -> lyr_loop2 [style=invis]
	lyr_loop2 -> lyr_loop3 [style=invis]
	lyr_loop3 -> lyr_loop4 [style=invis]
	lyr_loop4 -> lyr_loop5 [style=invis]
	lyr_loop5 -> lyr_end [style=invis]
	{
		rank=same
		lyr_start
		confirm0 [label="/bx-confirm0" fillcolor=lightskyblue group=spine shape=rectangle style=filled]
		confirmHere [label="/bx-confirm-here" fillcolor=lightskyblue shape=rectangle style="filled,dashed"]
		status [label="/bx-status" fillcolor=lightskyblue shape=rectangle style="filled,dashed"]
	}
	{
		rank=same
		lyr_loop1
		importArchive [label="/bx-import-archive" fillcolor=lightskyblue group=spine shape=rectangle style="filled,dashed"]
	}
	{
		rank=same
		lyr_loop2
		loopVia2 [label="" color=darkgreen group=loop shape=point width=0.03]
		work [label="Work on the selected TODO
in AI-WorkPlan.org" fillcolor=plum group=spine shape=rectangle style="filled,rounded,bold"]
		subjContent [label="Repo content
(working tree)" fillcolor=white fontsize=11 group=subjects shape=folder style="filled,bold"]
	}
	{
		rank=same
		lyr_loop3
		loopVia3 [label="" color=darkgreen group=loop shape=point width=0.03]
		commitMsg [label="/bx-commit-msg" fillcolor=plum group=spine shape=rectangle style="filled,dashed"]
		subjGit [label="Repo git
(.git)" fillcolor=white fontsize=11 group=subjects shape=cylinder style="filled,bold"]
	}
	{
		rank=same
		lyr_loop4
		loopVia4 [label="" color=darkgreen group=loop shape=point width=0.03]
		subjOutputs [label="AI-Outputs.org
(cross-project)" fillcolor=gainsboro fontsize=11 shape=note style="filled,bold"]
		aiOutputs [label="/bx-ai-outputs" fillcolor=plum group=spine shape=rectangle style="filled,dashed"]
	}
	{
		rank=same
		lyr_loop5
		done [label="/bx-done <anchor>" fillcolor=lightpink group=spine shape=rectangle style=filled]
		subjWorkPlan [label="AI-WorkPlan.org
(+ _archive)" fillcolor=white fontsize=11 group=subjects shape=note style="filled,bold"]
	}
	{
		rank=same
		lyr_end
		updateStatus [label="/bx-update-status" fillcolor=lightpink group=spine shape=rectangle style=filled]
		archive [label="/bx-archive" fillcolor=plum shape=rectangle style="filled,dashed"]
		subjDevStatus [label="AI-DevStatus.org" fillcolor=white fontsize=11 group=subjects shape=note style="filled,bold"]
	}
	subjContent -> subjGit [label=" you: git add, 
 git commit -t " arrowhead=normal color=black fontsize=9 penwidth=1.6 style=dashed]
	subjGit -> subjWorkPlan [style=invis]
	subjWorkPlan -> subjDevStatus [style=invis]
	work -> subjContent [arrowhead=normal color=crimson penwidth=1.6]
	commitMsg -> subjGit [label=" .git/CLAUDE_COMMIT_MSG " arrowhead=normal color=crimson fontcolor=crimson fontsize=9 penwidth=1.6]
	lyr_loop2 -> loopVia2 [style=invis]
	loopVia2 -> work [style=invis]
	lyr_loop3 -> loopVia3 [style=invis]
	loopVia3 -> commitMsg [style=invis]
	lyr_loop4 -> loopVia4 [style=invis]
	loopVia4 -> subjOutputs [style=invis]
	subjOutputs -> aiOutputs [style=invis]
	subjDevStatus -> archive [style=invis]
	aiOutputs -> subjOutputs [label=" capture " arrowhead=normal color=crimson constraint=false fontcolor=crimson fontsize=9 penwidth=1.6]
	done -> subjWorkPlan [arrowhead=normal color=crimson penwidth=1.6]
	archive -> subjWorkPlan [arrowhead=normal color=crimson constraint=false penwidth=1.6]
	updateStatus -> subjDevStatus [arrowhead=normal color=crimson penwidth=1.6]
	confirm0 -> importArchive
	importArchive -> work
	work -> commitMsg
	commitMsg -> aiOutputs
	aiOutputs -> done
	done -> updateStatus [label="  end of session  " fontsize=10]
	importArchive -> loopVia2 [color=darkgreen dir=back penwidth=1.6]
	loopVia2 -> loopVia3 [color=darkgreen dir=none penwidth=1.6]
	loopVia3 -> loopVia4 [label="  next TODO  " color=darkgreen dir=none fontcolor=darkgreen fontsize=10 penwidth=1.6]
	loopVia4 -> done [color=darkgreen dir=none penwidth=1.6]
	confirm0 -> confirmHere [label=" or " arrowhead=none fontsize=10 style=dotted]
	confirmHere -> status [label=" and/or " arrowhead=none fontsize=10 style=dotted]
	legend [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="lightskyblue">read</TD><TD BGCOLOR="lightpink">write</TD><TD BGCOLOR="plum">read-write</TD><TD>solid border = always</TD><TD STYLE="dashed">dashed border = perhaps</TD><TD><FONT COLOR="crimson">red arrow = Claude writes</FONT></TD><TD>dashed black arrow = you write</TD></TR><TR><TD COLSPAN="7">right of the main path = this repo;  left (grey) = outside this repo, shared across projects</TD></TR></TABLE>> fontsize=10 shape=plaintext]
	updateStatus -> legend [style=invis]
}
