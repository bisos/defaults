""" #+begin_org
* Overview and Relevant Pointers
The AI-Activity session workflow as a sequence of =/bx-*= slash commands.
Lives in =_nonTemplate_/= --- the templates tree's one escape from the
templates concept --- next to the commands it depicts
(=mother/_claude/commands/=) and their description (=mother/AI-WORKFLOW.org=).
#+end_org """

from bisos import b
from bisos.b import cs

import graphviz

from bisos.graphviz import graphvizSeed
ng = graphvizSeed.namedGraph


####+BEGIN: b:py3:cs:orgItem/basic :type "=Seed Setup= " :title "*Common Facilities*" :comment "General"
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  =Seed Setup=  [[elisp:(outline-show-subtree+toggle)][||]] *Common Facilities* General  [[elisp:(org-cycle)][| ]]
#+end_org """
####+END:

namedGraphsList = [
    # Forward reference: aiWorkflow is defined below this block.
    ng("aiWorkflow",
       func=lambda: aiWorkflow(),
       title="AI-Activity Session Workflow",
       caption="The /bx-* slash commands in the order a typical session "
               "uses them: setup once, confirm context at session start, "
               "a per-TODO work loop, and housekeeping at session end. "
               "Fill shows what a command does to files: blue reads into "
               "the session, pink writes session knowledge to files, "
               "purple does both. Solid borders are always done; dashed "
               "borders are 'perhaps'."),
]

graphvizSeed.setup(
    seedType="common",
    namedGraphsList=namedGraphsList,
)

####+BEGIN: b:py3:cs:func/typing :funcName "aiWorkflow" :funcType "Typed" :deco "track"
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  F-T-Typed  [[elisp:(outline-show-subtree+toggle)][||]] /aiWorkflow/  deco=track  [[elisp:(org-cycle)][| ]]
#+end_org """
@cs.track(fnLoc=True, fnEntry=True, fnExit=True)
def aiWorkflow(
####+END:
) -> graphviz.Digraph:
    """ #+begin_org
** [[elisp:(org-cycle)][| *DocStr | ]  Layered session workflow: setup --> session start -->
    per-TODO work loop --> session end.
    #+end_org """

    d = graphviz.Digraph()
    d.attr(rankdir='TB', nodesep='0.35', ranksep='0.45')
    d.attr('node', fontsize='12')

    # Fill = effect on files (blue + pink = purple is the mnemonic):
    #   lightskyblue = read       --- loads into the session, changes no files
    #   lightpink    = write      --- records session knowledge into files
    #   plum         = read-write --- both
    # Border: solid = always, dashed = perhaps.
    read = {'style': 'filled', 'fillcolor': 'lightskyblue'}
    write = {'style': 'filled', 'fillcolor': 'lightpink'}
    readWrite = {'style': 'filled', 'fillcolor': 'plum'}

    def perhaps(kind: dict) -> dict:
        return {**kind, 'style': 'filled,dashed'}

    cmndShape = {'shape': 'rectangle'}

    # Left column: one plaintext label per layer, chained invisibly to
    # hold the layers in order.
    layerLabels = [
        ('lyr_setup',   'Setup\n(once per directory)'),
        ('lyr_start',   'Session start'),
        ('lyr_loop1',   'Work loop\n(per TODO)'),
        ('lyr_loop2',   ''),
        ('lyr_loop3',   ''),
        ('lyr_loop4',   ''),
        ('lyr_loop5',   ''),
        ('lyr_end',     'Session end'),
    ]
    for name, label in layerLabels:
        d.node(name, label, shape='plaintext', fontsize='11', fontcolor='gray30')
    for (upper, _), (lower, _) in zip(layerLabels, layerLabels[1:]):
        d.edge(upper, lower, style='invis')

    def layer(labelNode: str, nodes: list) -> None:
        with d.subgraph() as s:
            s.attr(rank='same')
            s.node(labelNode)
            for name, label, attrs in nodes:
                s.node(name, label, **cmndShape, **attrs)

    layer('lyr_setup', [
        ('initiate', '/bx-initiate\n(or aiActivity.cs -i initiate\nfrom the shell)', perhaps(readWrite)),
    ])
    layer('lyr_start', [
        ('confirm0',    '/bx-confirm0',    read),
        ('confirmHere', '/bx-confirm-here', perhaps(read)),
        ('status',      '/bx-status',       perhaps(read)),
    ])
    layer('lyr_loop1', [
        ('importArchive', '/bx-import-archive', perhaps(read)),
    ])
    layer('lyr_loop2', [
        ('work', 'Work on the selected TODO\nin AI-WorkPlan.org', {**readWrite, 'style': 'filled,rounded,bold'}),
    ])
    layer('lyr_loop3', [
        ('commitMsg', 'git add, then\n/bx-commit-msg', perhaps(readWrite)),
    ])
    layer('lyr_loop4', [
        ('aiOutputs', '/bx-ai-outputs', perhaps(readWrite)),
    ])
    layer('lyr_loop5', [
        ('done', '/bx-done <anchor>', write),
    ])
    layer('lyr_end', [
        ('updateStatus', '/bx-update-status', write),
        ('archive',      '/bx-archive',       perhaps(readWrite)),
        ('contextTrim',  '/bx-context-trim',  perhaps(readWrite)),
    ])

    # Main path.
    d.edge('initiate', 'confirm0')
    d.edge('initiate', 'confirmHere', style='dashed', arrowhead='none')
    d.edge('confirm0', 'importArchive')
    d.edge('importArchive', 'work')
    d.edge('work', 'commitMsg')
    d.edge('commitMsg', 'aiOutputs')
    d.edge('aiOutputs', 'done')
    d.edge('done', 'updateStatus', label='  end of session  ', fontsize='10')

    # Loop back for the next TODO. constraint=false keeps it off the ranking.
    d.edge('done', 'importArchive', label='  next TODO  ', fontsize='10',
           color='darkgreen', fontcolor='darkgreen', penwidth='1.6', constraint='false')

    # Alternatives at session start (same rank, not sequential).
    d.edge('confirm0', 'confirmHere', style='dotted', arrowhead='none', label=' or ', fontsize='10')
    d.edge('confirmHere', 'status', style='dotted', arrowhead='none', label=' and/or ', fontsize='10')

    # Housekeeping after the status update.
    d.edge('updateStatus', 'archive', style='dotted', arrowhead='none')
    d.edge('archive', 'contextTrim', style='dotted', arrowhead='none')

    # Legend, as a borderless table below everything.
    d.node('legend',
           '<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">'
           '<TR><TD BGCOLOR="lightskyblue">read</TD>'
           '<TD BGCOLOR="lightpink">write</TD>'
           '<TD BGCOLOR="plum">read-write</TD>'
           '<TD>solid border = always</TD>'
           '<TD STYLE="dashed">dashed border = perhaps</TD></TR>'
           '</TABLE>>',
           shape='plaintext', fontsize='10')
    d.edge('lyr_end', 'legend', style='invis')

    return d

""" #+begin_org
#+begin_src sh :results output :session shared
aiWorkflow-graphviz.pcs --format=evince  -i ngProcess aiWorkflow
#+end_src
#+end_org """
